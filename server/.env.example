DATABASE_URL="postgresql://postgres:password@localhost:5432/rental_marketplace"
JWT_SECRET="replace_with_a_long_random_secret_at_least_64_chars"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
WAZE_API_KEY="your_openwebninja_api_key"

# Cloudinary — server-side only, NEVER expose to frontend
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
